global:
  scrape_interval: 15s # Set the scrape interval to every 15 seconds. Default is every 1 minute.
  evaluation_interval: 15s # Evaluate rules every 15 seconds. The default is every 1 minute.

  external_labels:
    monitor: "fds"

# Alertmanager configuration
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

scrape_configs:
  - job_name: "node_exporter"
    static_configs:
      - targets: [{% for host in groups['all'] %}{% if 'node' in hostvars[host].monitor_prometheus_exporters %}"{{ hostvars[host].host_data.site_ipv4 }}:9100"{% endif %}{% if not loop.last %}{% if 'node' in hostvars[loop.nextitem].monitor_prometheus_exporters %},{% endif %}{% endif %}{% endfor %}]

  - job_name: "postgres_exporter"
    static_configs:
      - targets: [{% for host in groups['all'] %}{% if 'postgres' in hostvars[host].monitor_prometheus_exporters %}"{{ hostvars[host].host_data.site_ipv4 }}:9187"{% endif %}{% if not loop.last %}{% if 'postgres' in hostvars[loop.nextitem].monitor_prometheus_exporters %},{% endif %}{% endif %}{% endfor %}]

  - job_name: "postfix_exporter"
    static_configs:
      - targets: [{% for host in groups['all'] %}{% if 'postfix' in hostvars[host].monitor_prometheus_exporters %}"{{ hostvars[host].host_data.site_ipv4 }}:9154"{% endif %}{% if not loop.last %}{% if 'nginx' in hostvars[loop.nextitem].monitor_prometheus_exporters %},{% endif %}{% endif %}{% endfor %}]

  - job_name: "nginx_exporter"
    static_configs:
      - targets: [{% for host in groups['all'] %}{% if 'nginx' in hostvars[host].monitor_prometheus_exporters %}"{{ hostvars[host].host_data.site_ipv4 }}:9113"{% endif %}{% if not loop.last %}{% if 'nginx' in hostvars[loop.nextitem].monitor_prometheus_exporters %},{% endif %}{% endif %}{% endfor %}]

  - job_name: "statsd_exporter"
    static_configs:
      - targets: [{% for host in groups['all'] %}{% if 'statsd' in hostvars[host].monitor_prometheus_exporters %}"{{ hostvars[host].host_data.site_ipv4 }}:9102"{% endif %}{% if not loop.last %}{% if 'statsd' in hostvars[loop.nextitem].monitor_prometheus_exporters %},{% endif %}{% endif %}{% endfor %}]

  - job_name: "celery_exporter"
    static_configs:
      - targets: [{% for host in groups['all'] %}{% if 'celery' in hostvars[host].monitor_prometheus_exporters %}"{{ hostvars[host].host_data.site_ipv4 }}:9808"{% endif %}{% if not loop.last %}{% if 'celery' in hostvars[loop.nextitem].monitor_prometheus_exporters %},{% endif %}{% endif %}{% endfor %}]
